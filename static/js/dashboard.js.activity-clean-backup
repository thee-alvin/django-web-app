/* ============================================================
   RECENT ACTIVITY
   ============================================================ */

async function loadRecentActivity() {

    const list =
        document.getElementById(
            "activityList"
        );

    if (!list) {
        return;
    }

    try {

        const response =
            await fetch(
                "/api/member/activity",
                {
                    method: "GET",
                    credentials: "same-origin",
                    headers: {
                        "Accept":
                            "application/json"
                    },
                    cache: "no-store"
                }
            );

        const data =
            await response.json();

        if (
            response.status === 401
        ) {
            window.location.href =
                "/login";
            return;
        }

        if (
            !response.ok ||
            !data.success
        ) {
            return;
        }

        const activities =
            Array.isArray(data.activities)
                ? data.activities
                    .filter((activity) => {
                        const action =
                            String(
                                activity.action || ""
                            ).trim().toLowerCase();

                        return !action.startsWith("viewed ");
                    })
                    .slice(0, 5)
                : [];

        if (!activities.length) {
            return;
        }

        list.innerHTML =
            activities
                .map(
                    (activity) => {

                        const date =
                            new Date(
                                activity.timestamp
                            );

                        const formattedDate =
                            Number.isNaN(
                                date.getTime()
                            )
                                ? activity.timestamp
                                : date.toLocaleString(
                                    "en-KE",
                                    {
                                        dateStyle:
                                            "medium",
                                        timeStyle:
                                            "short"
                                    }
                                );

                        return `
                            <div class="activity-item">

                                <div class="activity-icon">
                                    ●
                                </div>

                                <div class="activity-content">

                                    <strong>
                                        ${
                                            String(
                                                activity.action ||
                                                "Account Activity"
                                            )
                                        }
                                    </strong>

                                    <p>
                                        ${
                                            String(
                                                activity.description ||
                                                ""
                                            )
                                        }
                                    </p>

                                    <small>
                                        ${formattedDate}
                                    </small>

                                </div>

                            </div>
                        `;
                    }
                )
                .join("");

    } catch (error) {

        console.error(
            "Recent activity loading:",
            error
        );
    }
}


document.addEventListener(
    "DOMContentLoaded",
    loadRecentActivity
);

